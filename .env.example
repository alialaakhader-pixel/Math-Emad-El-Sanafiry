# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: enables the AI math assistant (/api/assistant). Without it the assistant
# reports honestly that it is not configured instead of pretending to work.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional: enables "Sign in with Google" (Supabase Auth / Google OAuth provider).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
